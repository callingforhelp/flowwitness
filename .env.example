# Default npm start is a trusted local-only service on 127.0.0.1:4310.
# External binding requires two different strong tokens (at least 32 characters).
# Never commit real values. The dashboard holds entered tokens only in memory.
HOST=127.0.0.1
PORT=4310
FLOWWITNESS_APPLICATION=demo-reports
FLOWWITNESS_PUBLIC_ORIGIN=http://127.0.0.1:4310
FLOWWITNESS_DATA_DIR=.flowwitness/private
FLOWWITNESS_ALLOWED_ORIGINS=http://127.0.0.1:4310
FLOWWITNESS_ADMIN_TOKEN=
FLOWWITNESS_SUPPORT_TOKEN=
FLOWWITNESS_WEBHOOK_SECRET=
