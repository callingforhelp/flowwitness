# Default npm start is a trusted local-only service on 127.0.0.1:4310.
# External binding requires two different strong tokens (at least 32 characters).
# Never commit real values. The dashboard holds entered tokens only in memory.
HOST=127.0.0.1
PORT=4310
FLOWWITNESS_APPLICATION=demo-reports
FLOWWITNESS_PUBLIC_ORIGIN=http://127.0.0.1:4310
FLOWWITNESS_DATA_DIR=.flowwitness/private
FLOWWITNESS_ALLOWED_ORIGINS=http://127.0.0.1:4310
FLOWWITNESS_BROWSER_ORIGIN=
FLOWWITNESS_STATE_BACKEND=local
# Module records use this backend too unless explicitly overridden at startup.
FLOWWITNESS_MODULE_STATE_BACKEND=local
# Hosted mode only: keep the project-admin key in a secret manager.
FLOWWITNESS_INSFORGE_URL=
FLOWWITNESS_INSFORGE_API_KEY=
# Trusted module identities; support needs a non-empty conversation binding.
FLOWWITNESS_MODULE_ADMIN_SUBJECT_ID=admin
FLOWWITNESS_MODULE_ADMIN_CONVERSATION_ID=
FLOWWITNESS_MODULE_SUPPORT_SUBJECT_ID=support
FLOWWITNESS_MODULE_SUPPORT_CONVERSATION_ID=
FLOWWITNESS_STATE_MAX_BYTES=8000000
FLOWWITNESS_ADMIN_TOKEN=
FLOWWITNESS_SUPPORT_TOKEN=
FLOWWITNESS_WEBHOOK_SECRET=
